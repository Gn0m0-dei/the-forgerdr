{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/graph-augment.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Grep|Glob"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "statusMessage": "Loading forgerdr...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engram-session.sh\" stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engram-session.sh\" subagent",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
