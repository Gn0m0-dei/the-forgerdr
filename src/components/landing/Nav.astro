---
import { LANDING } from "#config/landing.ts";
import { SITE } from "#config/site.ts";
import { withBase } from "#helpers/url.ts";

const GITHUB_MARK =
  "M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z";
---

<header class="nav">
  <div class="container bar">
    <a class="brand tap" href={withBase("")}>
      <img class="pixelated" src={withBase("sprites/gnome-head.svg")} alt="" width="28" height="28" />
      <span class="display">{SITE.title}</span>
    </a>
    <nav class="wide" aria-label="Main">
      {LANDING.navLinks.map((link) => <a class="tap" href={link.href}>{link.label}</a>)}
      <a class="tap repository" href={SITE.repository}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={GITHUB_MARK} /></svg>
        GitHub
      </a>
    </nav>
    <details class="narrow" data-menu>
      <summary class="key display">Menu</summary>
      <nav aria-label="Main">
        {LANDING.navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="repository" href={SITE.repository}>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={GITHUB_MARK} /></svg>
          GitHub
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  import "#scripts/menu.ts";
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: var(--bg-0);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand .display {
    font-size: 0.9375rem;
    letter-spacing: 0.15em;
  }

  .wide {
    display: none;
  }

  .narrow summary {
    min-height: 44px;
    padding-inline: var(--space-4);
    cursor: pointer;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    list-style: none;
  }

  .narrow summary::-webkit-details-marker {
    display: none;
  }

  .narrow nav {
    position: absolute;
    right: var(--space-4);
    top: 100%;
    z-index: 10;
    display: grid;
    min-width: 200px;
    border: 1px solid var(--line);
    background: var(--bg-1);
  }

  .narrow nav a {
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
  }

  .repository {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 1024px) {
    .wide {
      display: flex;
      align-items: center;
      gap: var(--space-8);
    }

    .wide a {
      color: var(--fg-muted);
      text-decoration: none;
    }

    .wide a:hover {
      color: var(--fg);
    }

    .narrow {
      display: none;
    }
  }
</style>
