{
  "mcpServers": {
    "chrome-devtools": {
      "args": ["-y", "chrome-devtools-mcp@latest", "--isolated"],
      "command": "npx"
    },
    "codebase-memory": {
      "command": "${HOME}/.local/bin/codebase-memory-mcp"
    },
    "context7": {
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "command": "npx",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "engram": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/engram-mcp.sh"
    }
  }
}
