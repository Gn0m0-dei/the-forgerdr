{
  "compilerOptions": {
    "checkJs": true,
    "lib": [
      "ES2025",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.TypedArrays"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "strict": true,
    "strictNullChecks": false,
    "target": "ES2025"
  }
}
