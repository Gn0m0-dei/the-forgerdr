{
  "author": "Gn0m0-dei",
  "description": "Tells the herdr app's IDE panel which files are unsaved, and saves them when it asks",
  "entry": "forgerdr.lua",
  "name": "forgerdr",
  "permissions": {
    "commands": true,
    "editor.read": true,
    "events.editor": true,
    "events.file": true,
    "fs.read": ["*"],
    "fs.write": ["*"],
    "settings": true,
    "settings_keys": ["editor.showTrailingNewline"],
    "system.env": true,
    "system.exec": ["mv"]
  },
  "version": "1.0.0"
}
